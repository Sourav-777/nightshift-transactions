# Copy this file to .env and fill in your own values.
# .env is never committed / uploaded anywhere by this app.

PORT=3787

# ---- MySQL --------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=nightshift

# ---- Snowflake ------------------------------------------------------------
SNOWFLAKE_ACCOUNT=abc12345.us-east-1      # from your Snowflake account URL
SNOWFLAKE_USERNAME=your_user
SNOWFLAKE_PASSWORD=changeme
SNOWFLAKE_WAREHOUSE=NIGHTSHIFT_WH
SNOWFLAKE_DATABASE=NIGHTSHIFT
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=ACCOUNTADMIN

# ---- Power BI real-time streaming (optional but recommended) -------------
# Create a "Streaming dataset" (API type) in a Power BI workspace, matching
# the field list in powerbi/pushDataset.js, then paste its Push URL here.
# Leave blank to skip live Power BI push (MySQL/Snowflake writes still work).
POWERBI_PUSH_URL=
